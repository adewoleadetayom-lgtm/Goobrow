const express = /* GOOBROW ADVANCED MATH ENGINE */
const mathjs = require("mathjs");
const math = mathjs.create(mathjs.all);
const nerdamer = require("nerdamer/all");

function goobrowLooksLikeMath(q){
  const x=String(q||"").toLowerCase().trim();
  if(!x) return false;
  return /[=+*/^×÷%]/.test(x) ||
    /\b(solve|calculate|calculation|simplify|factor|expand|differentiate|derivative|integrate|integral|equation|quadratic|algebra|fraction|percentage|percent|square root|sqrt|sin|cos|tan|log|ln|matrix|probability|mean|median|mode|standard deviation|area|volume|perimeter|ratio|proportion)\b/.test(x) ||
    /\bwhat is\s+\d/.test(x) ||
    /^\s*\d+(\.\d+)?\s*(×|x|\*|÷|\/|\+|-)\s*\d+/.test(x);
}

function goobrowMathSolve(query){
  const original=String(query||"").trim();
  if(!original) return {ok:false,message:"Please enter a mathematical question."};

  let q=original.replace(/²/g,"^2").replace(/³/g,"^3").replace(/⁴/g,"^4").replace(/⁵/g,"^5").replace(/×/g,"*").replace(/÷/g,"/").replace(/√/g,"sqrt").replace(/π/g,"pi");

  try{
    if(/^[0-9a-zA-Z_().,+\-*/^%\s]+$/.test(q) && !/\b(solve|differentiate|derivative|integrate|integral|factor|expand|simplify)\b/i.test(q)){
      const value=math.evaluate(q);
      if(value!==undefined && value!==null && typeof value!=="function" && typeof value!=="object")
        return {ok:true,type:"calculation",question:original,answer:String(value)};
    }
  }catch{}

  let expr=q.replace(/^\s*(solve|calculate|simplify|factor|expand)\s+/i,"").replace(/^\s*what\s+is\s+/i,"").replace(/^\s*find\s+/i,"").trim();

  if(q.includes("=")){
    const parts=q.split("=");
    if(parts.length===2){
      try{
        const equation=parts[0].trim()+"-("+parts[1].trim()+")";
        return {ok:true,type:"equation",question:original,answer:nerdamer.solve(equation,"x").toString()};
      }catch{}
    }
  }

  if(/\b(differentiate|derivative)\b/i.test(q)){
    try{
      expr=expr.replace(/\b(differentiate|derivative)\b/ig,"").replace(/^\s*(of|for)\s+/i,"").replace(/\s+with\s+respect\s+to\s+x\s*$/i,"").trim();
      return {ok:true,type:"derivative",question:original,answer:math.derivative(expr,"x").toString()};
    }catch{}
  }

  if(/\b(integrate|integral)\b/i.test(q)){
    try{
      expr=expr.replace(/\b(integrate|integral)\b/ig,"").replace(/^\s*(of|for)\s+/i,"").trim();
      return {ok:true,type:"integral",question:original,answer:nerdamer.integrate(expr,"x").toString()};
    }catch{}
  }

  if(/\bfactor\b/i.test(q)){
    try{return {ok:true,type:"factor",question:original,answer:nerdamer.factor(expr).toString()};}catch{}
  }

  if(/\bexpand\b/i.test(q)){
    try{return {ok:true,type:"expand",question:original,answer:nerdamer.expand(expr).toString()};}catch{}
  }

  if(/\bsimplify\b/i.test(q)){
    try{return {ok:true,type:"simplification",question:original,answer:math.simplify(expr).toString()};}catch{}
  }

  try{
    const answer=nerdamer(expr).toString();
    if(answer && answer!==expr) return {ok:true,type:"algebra",question:original,answer};
  }catch{}

  return {ok:false,type:"math",question:original,message:"I could not solve this mathematical expression automatically. Try writing the problem more clearly."};
}
