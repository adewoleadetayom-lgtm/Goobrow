let goobrowLocalIndex = [];

try {
  const fs = require("fs");
  const indexPath = path.join(__dirname, "data", "index.json");

  if (fs.existsSync(indexPath)) {
    goobrowLocalIndex = JSON.parse(fs.readFileSync(indexPath, "utf8"));
