<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Goobrow</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;color:#202124;background:#fff}
.topbar{height:60px;display:flex;align-items:center;justify-content:flex-end;padding:0 24px;gap:20px;font-size:14px}
.menuWrap{position:relative}
.menuBtn{border:0;background:transparent;font-size:27px;cursor:pointer;padding:6px 10px;border-radius:50%}
.menuBtn:hover{background:#f1f3f4}
.menuPanel{display:none;position:absolute;right:0;top:48px;width:210px;background:#fff;border:1px solid #ddd;border-radius:12px;box-shadow:0 4px 18px #0002;z-index:20;overflow:hidden}
.menuPanel.open{display:block}
.menuPanel a{display:block;padding:13px 16px;color:#202124;text-decoration:none;font-size:14px}
.menuPanel a:hover{background:#f5f5f5}
.topbar a{color:#202124;text-decoration:none}
.home{min-height:calc(100vh - 100px);display:flex;flex-direction:column;align-items:center;padding-top:130px}
.logo{font-size:64px;font-weight:700;letter-spacing:-5px;margin-bottom:28px}
.logo span:nth-child(1){color:#4285f4}.logo span:nth-child(2){color:#ea4335}.logo span:nth-child(3){color:#fbbc05}.logo span:nth-child(4){color:#4285f4}.logo span:nth-child(5){color:#34a853}.logo span:nth-child(6){color:#ea4335}.logo span:nth-child(7){color:#4285f4}
.searchWrap{width:min(680px,92%);position:relative}
.search{height:52px;border:1px solid #dfe1e5;border-radius:28px;display:flex;align-items:center;padding:0 18px;box-shadow:0 1px 6px #20212418}
.search:focus-within{box-shadow:0 1px 8px #20212435}
.searchIcon{font-size:20px;margin-right:12px}
.search input{flex:1;border:0;outline:0;font-size:17px;background:transparent}
.search button{border:0;background:none;font-size:21px;cursor:pointer}
.suggestions{position:absolute;top:58px;left:0;right:0;background:#fff;border-radius:14px;box-shadow:0 3px 12px #0002;overflow:hidden;z-index:5}
.suggestion{padding:12px 18px;cursor:pointer;font-size:15px}
.suggestion:hover{background:#f5f5f5}
.buttons{display:flex;gap:12px;margin-top:28px}
.buttons button{border:1px solid #f8f9fa;background:#f8f9fa;padding:11px 18px;border-radius:5px;font-size:14px;cursor:pointer}
.buttons button:hover{border-color:#dadce0}
.newsSection{width:min(1050px,94%);margin:55px auto 90px}
.newsHeader{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.newsHeader h2{font-size:22px;margin:0}
.newsHeader a{color:#1a73e8;text-decoration:none;font-size:14px}
.newsGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.newsCard{border:1px solid #e0e0e0;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 1px 4px #0001}
.newsCard img{width:100%;height:145px;object-fit:cover;display:block}
.newsCard.noimage{padding-top:0}
.newsBody{padding:13px}
.newsTitle{font-size:15px;font-weight:600;line-height:1.4;color:#202124;text-decoration:none}
.newsTitle:hover{text-decoration:underline}
.newsSource{font-size:12px;color:#5f6368;margin-top:9px}
.newsEmpty{color:#70757a;font-size:14px}
.footer{padding:14px;text-align:center;background:#f2f2f2;color:#70757a;font-size:13px}
@media(max-width:850px){.newsGrid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.newsGrid{grid-template-columns:1fr}.newsCard img{height:180px}}
@media(max-width:600px){
.home{padding-top:90px}.logo{font-size:52px}.buttons{flex-wrap:wrap;justify-content:center}
}
</style>
</head>
<body>

<div class="topbar">
<div class="menuWrap">
<button class="menuBtn" id="menuBtn" aria-label="Open menu">☰</button>
<div class="menuPanel" id="menuPanel">
<a href="index.html">🏠 Home</a>
<a href="results.html?mode=all">🔎 All</a>
<a href="images.html">🖼️ Images</a>
<a href="results.html?mode=videos">🎬 Videos</a>
<a href="results.html?mode=news">📰 News</a>
<a href="results.html?mode=ai">✨ AI Mode</a>
</div>
</div>
<a href="images.html">Images</a>
<a href="results.html?mode=news">News</a>
</div>

<main class="home">
<div class="logo"><span>G</span><span>o</span><span>o</span><span>b</span><span>r</span><span>o</span><span>w</span></div>

<div class="searchWrap">
<form class="search" id="searchForm">
<span class="searchIcon">🔎</span>
<input id="searchInput" autocomplete="off" autofocus placeholder="Search with Goobrow">
<button type="submit">🔍</button>
</form>
<div id="suggestions" class="suggestions" hidden></div>
</div>

<div class="buttons">
<button type="button" onclick="goSearch()">Goobrow Search</button>
<button type="button" onclick="goImages()">Goobrow Images</button>
</div>
</main>

<section class="newsSection">
<div class="newsHeader">
<h2>📰 Recent & Trending News</h2>
<a href="results.html?mode=news">View all</a>
</div>
<div id="homeNews" class="newsGrid">
<div class="newsEmpty">Loading recent news...</div>
</div>
</section>

<div class="footer">Goobrow Search</div>

<script>
const input=document.getElementById("searchInput");
const suggestions=document.getElementById("suggestions");
const form=document.getElementById("searchForm");
let timer;

function goSearch(){
 const q=input.value.trim();
 if(q) location.href="results.html?q="+encodeURIComponent(q)+"&mode=all";
}

function goImages(){
 const q=input.value.trim();
 if(q) location.href="images.html?q="+encodeURIComponent(q);
}

form.addEventListener("submit",e=>{
 e.preventDefault();
 goSearch();
});

input.addEventListener("input",()=>{
 clearTimeout(timer);
 const q=input.value.trim();

 if(!q){
  suggestions.innerHTML="";
  suggestions.hidden=true;
  return;
 }

 timer=setTimeout(async()=>{
  try{
   const r=await fetch("/api/suggestions?q="+encodeURIComponent(q));
   const data=await r.json();
   const list=data.suggestions||[];

   suggestions.innerHTML="";
   list.forEach(item=>{
    const div=document.createElement("div");
    div.className="suggestion";
    div.textContent=item;
    div.onclick=()=>{
     input.value=item;
     goSearch();
    };
    suggestions.appendChild(div);
   });

   suggestions.hidden=list.length===0;
  }catch{
   suggestions.hidden=true;
  }
 },150);
});

document.addEventListener("click",e=>{
 if(!e.target.closest(".searchWrap")){
  suggestions.hidden=true;
 }
});

const menuBtn=document.getElementById("menuBtn");
const menuPanel=document.getElementById("menuPanel");

menuBtn.addEventListener("click",e=>{
 e.stopPropagation();
 menuPanel.classList.toggle("open");
});

document.addEventListener("click",e=>{
 if(!e.target.closest(".menuWrap")){
  menuPanel.classList.remove("open");
 }
});

async function loadHomeNews(){
 const box=document.getElementById("homeNews");
 if(!box)return;

 try{
  const r=await fetch("/api/news?q=latest news");
  const data=await r.json();
  const news=data.results||[];

  if(!news.length){
   box.innerHTML='<div class="newsEmpty">Recent news is temporarily unavailable.</div>';
   return;
  }

  box.innerHTML=news.slice(0,8).map(item=>{
   const title=String(item.title||"");
   const url=String(item.url||"#");
   const image=String(item.image||"");

   return `
    <article class="newsCard ${image?"":"noimage"}">
     ${image ? `<a href="${escapeAttr(url)}" target="_blank" rel="noopener">
       <img src="${escapeAttr(image)}" loading="lazy" alt="${escapeAttr(title)}">
     </a>` : ""}
     <div class="newsBody">
      <a class="newsTitle" href="${escapeAttr(url)}" target="_blank" rel="noopener">
       ${escapeHtml(title)}
      </a>
      <div class="newsSource">Latest news</div>
     </div>
    </article>
   `;
  }).join("");

 }catch(error){
  box.innerHTML='<div class="newsEmpty">Recent news is temporarily unavailable.</div>';
 }
}

function escapeAttr(text){
 return String(text||"")
  .replace(/&/g,"&amp;")
  .replace(/"/g,"&quot;")
  .replace(/</g,"&lt;")
  .replace(/>/g,"&gt;");
}

loadHomeNews();
</script>
</body>
</html>