<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Goobrow Search</title>

<style>
*{box-sizing:border-box}

body{
 margin:0;
 font-family:Arial,Helvetica,sans-serif;
 color:#202124;
 background:#fff
}

.header{
 border-bottom:1px solid #eee;
 padding:14px 22px
}

.headrow{
 display:flex;
 align-items:center;
 gap:22px
}

.menu{
 font-size:25px;
 text-decoration:none;
 color:#333
}

.logo{
 font-size:30px;
 font-weight:700;
 letter-spacing:-2px;
 text-decoration:none
}

.logo span:nth-child(1){color:#4285f4}
.logo span:nth-child(2){color:#ea4335}
.logo span:nth-child(3){color:#fbbc05}
.logo span:nth-child(4){color:#4285f4}
.logo span:nth-child(5){color:#34a853}
.logo span:nth-child(6){color:#ea4335}
.logo span:nth-child(7){color:#4285f4}

.search{
 margin-top:14px;
 width:min(700px,100%);
 height:48px;
 border:1px solid #dfe1e5;
 border-radius:25px;
 display:flex;
 align-items:center;
 padding:0 15px;
 background:#fff
}

.search:focus-within{
 box-shadow:0 1px 6px #20212430
}

.search input{
 flex:1;
 border:0;
 outline:0;
 font-size:16px;
 min-width:0
}

.search button{
 border:0;
 background:none;
 font-size:20px;
 cursor:pointer
}

.tabs{
 width:min(1000px,94%);
 margin:auto;
 border-bottom:1px solid #eee;
 display:flex;
 gap:4px;
 overflow-x:auto
}

.tab{
 padding:15px 18px;
 text-decoration:none;
 color:#5f6368;
 white-space:nowrap;
 cursor:pointer
}

.tab.active{
 color:#1a73e8;
 border-bottom:3px solid #1a73e8
}

.content{
 width:min(900px,94%);
 margin:25px auto 60px
}

.result{
 margin-bottom:28px
}

.result a.title{
 font-size:20px;
 color:#1a0dab;
 text-decoration:none
}

.result a.title:hover{
 text-decoration:underline
}

.url{
 font-size:13px;
 color:#188038;
 margin:5px 0
}

.desc{
 font-size:14px;
 line-height:1.5;
 color:#4d5156
}

/* IMAGES */

.imageGrid{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:14px
}

.imageCard{
 border:1px solid #eee;
 border-radius:12px;
 overflow:hidden;
 background:#fff;
 transition:.15s
}

.imageCard:hover{
 box-shadow:0 2px 10px #0002;
 transform:translateY(-1px)
}

.imageCard img{
 width:100%;
 height:170px;
 object-fit:cover;
 display:block;
 background:#f5f5f5
}

.imageTitle{
 padding:9px;
 font-size:13px;
 line-height:1.35
}

/* VIDEOS */

.videoGrid{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:20px
}

.videoCard{
 border:1px solid #e5e5e5;
 border-radius:12px;
 overflow:hidden;
 background:#fff;
 transition:.15s
}

.videoCard:hover{
 box-shadow:0 2px 10px #0002
}

.videoThumb{
 position:relative;
 width:100%;
 aspect-ratio:16/9;
 background:#eee;
 overflow:hidden
}

.videoThumb img{
 width:100%;
 height:100%;
 object-fit:cover;
 display:block
}

.play{
 position:absolute;
 left:50%;
 top:50%;
 transform:translate(-50%,-50%);
 width:58px;
 height:58px;
 border-radius:50%;
 background:#000b;
 color:white;
 display:flex;
 align-items:center;
 justify-content:center;
 font-size:25px;
 padding-left:4px
}

.videoInfo{
 padding:13px
}

.videoTitle{
 color:#202124;
 font-size:16px;
 font-weight:600;
 line-height:1.35;
 text-decoration:none;
 display:block
}

.videoTitle:hover{
 color:#1a73e8
}

.videoUrl{
 font-size:12px;
 color:#188038;
 margin-top:7px;
 white-space:nowrap;
 overflow:hidden;
 text-overflow:ellipsis
}

/* NEWS */

.newsCard{
 display:flex;
 gap:15px;
 border-bottom:1px solid #eee;
 padding:15px 0
}

.newsThumb{
 width:150px;
 height:90px;
 flex:none;
 object-fit:cover;
 border-radius:8px;
 background:#eee
}

.newsBody{
 flex:1
}

.newsTitle{
 font-size:18px;
 color:#1a0dab;
 text-decoration:none;
 line-height:1.3
}

.newsTitle:hover{
 text-decoration:underline
}

/* AI */

.aiBox{
 border:1px solid #dadce0;
 border-radius:16px;
 padding:20px;
 margin-bottom:25px;
 background:#fff;
 box-shadow:0 1px 4px #0001
}

.aiTitle{
 font-size:20px;
 font-weight:600;
 margin-bottom:12px
}

.aiAnswer{
 font-size:15px;
 line-height:1.7;
 white-space:pre-wrap
}

@media(max-width:700px){

 .header{
  padding:12px 15px
 }

 .logo{
  font-size:25px
 }

 .content{
  width:94%;
  margin-top:18px
 }

 .imageGrid{
  grid-template-columns:repeat(2,1fr);
  gap:10px
 }

 .imageCard img{
  height:140px
 }

 .videoGrid{
  grid-template-columns:1fr;
  gap:15px
 }

 .videoTitle{
  font-size:15px
 }

 .newsThumb{
  width:110px;
  height:75px
 }

 .newsTitle{
  font-size:16px
 }
}
</style>

<style id="goobrow-news-media-style">
.goobrow-news-card{
  display:flex;
  gap:16px;
  padding:16px 0;
  border-bottom:1px solid #e5e7eb;
  max-width:850px;
}

.goobrow-news-media{
  width:180px;
  min-width:180px;
  height:110px;
  border-radius:10px;
  overflow:hidden;
  background:#f1f3f4;
}

.goobrow-news-media img,
.goobrow-news-media video{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.goobrow-news-content{
  flex:1;
  min-width:0;
}

.goobrow-news-title{
  font-size:19px;
  line-height:1.35;
  margin-bottom:7px;
}

.goobrow-news-title a{
  color:#1a0dab;
  text-decoration:none;
}

.goobrow-news-title a:hover{
  text-decoration:underline;
}

.goobrow-news-source{
  font-size:13px;
  color:#5f6368;
  margin-bottom:7px;
}

.goobrow-news-description{
  font-size:14px;
  line-height:1.5;
  color:#4d5156;
}

.goobrow-news-date{
  font-size:12px;
  color:#70757a;
  margin-top:7px;
}

@media(max-width:650px){
  .goobrow-news-card{
    gap:10px;
  }

  .goobrow-news-media{
    width:115px;
    min-width:115px;
    height:80px;
  }

  .goobrow-news-title{
    font-size:16px;
  }

  .goobrow-news-description{
    font-size:13px;
  }
}
</style>

</head>

<body>

<header class="header">

<div class="headrow">
<a class="menu" href="index.html">☰</a>

<a class="logo" href="index.html">
<span>G</span><span>o</span><span>o</span><span>b</span>
<span>r</span><span>o</span><span>w</span>
</a>
</div>

<form class="search" id="searchForm">
<input id="searchInput"
 autocomplete="off"
 placeholder="Search with Goobrow">

<button type="submit">🔎</button>
</form>

</header>

<nav class="tabs">

<a class="tab" data-mode="all">All</a>
<a class="tab" data-mode="images">Images</a>
<a class="tab" data-mode="videos">Videos</a>
<a class="tab" data-mode="news">News</a>
<a class="tab" data-mode="ai">AI Mode</a>
<a class="tab" data-mode="academic">Academics</a>

</nav>

<main class="content">
<div id="results"></div>

<div id="goobrow-google-cse" style="margin:20px 0;">
  </div>
</main>

<script>

const params=new URLSearchParams(location.search);

const query=params.get("q")||"";
const mode=params.get("mode")||"all";

const input=document.getElementById("searchInput");
const results=document.getElementById("results");

input.value=query;

document.querySelectorAll(".tab").forEach(tab=>{

 tab.classList.toggle(
  "active",
  tab.dataset.mode===mode
 );

 tab.onclick=()=>{

  if(!query)return;

  location.href=
   "results.html?q="+
   encodeURIComponent(query)+
   "&mode="+
   tab.dataset.mode;

 };

});

document
.getElementById("searchForm")
.addEventListener("submit",e=>{

 e.preventDefault();

 const q=input.value.trim();

 if(q){

  location.href=
   "results.html?q="+
   encodeURIComponent(q)+
   "&mode=all";

 }

});

function esc(x){

 const d=document.createElement("div");

 d.textContent=x??"";

 return d.innerHTML;

}


/* ALL */

async function loadAll(){

 try{

  const r=await fetch(
   "/api/search?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No results found.</p>";

   return;

  }

  results.innerHTML=d.results.map(x=>`

   <div class="result">

    <a class="title"
       href="${esc(x.url)}"
       target="_blank"
       rel="noopener">

       ${esc(x.title)}

    </a>

    <div class="url">
     ${esc(x.url)}
    </div>

    <div class="desc">
     ${esc(x.description)}
    </div>

   </div>

  `).join("");

 }catch{

  results.innerHTML=
   "<p>Goobrow could not load results.</p>";

 }

}


/* IMAGES */

async function loadImages(){

 try{

  const r=await fetch(
   "/api/images?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No images found.</p>";

   return;

  }

  results.innerHTML=
   '<div class="imageGrid">'+

   d.results.map(x=>`

    <div class="imageCard">

     <a href="${esc(x.image)}"
        target="_blank"
        rel="noopener">

      <img
       src="${esc(x.image)}"
       loading="lazy"
       alt="${esc(x.title)}">

     </a>

     <div class="imageTitle">
      ${esc(x.title)}
     </div>

    </div>

   `).join("")+

   '</div>';

 }catch{

  results.innerHTML=
   "<p>Goobrow image search is unavailable.</p>";

 }

}


/* VIDEOS */

async function loadVideos(){

 try{

  const r=await fetch(
   "/api/videos?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No video results found.</p>";

   return;

  }

  results.innerHTML=
   '<div class="videoGrid">'+

   d.results.map(x=>`

    <article class="videoCard">

     <a href="${esc(x.url)}"
        target="_blank"
        rel="noopener">

      <div class="videoThumb">

       ${
        x.image
        ?
        `<img
          src="${esc(x.image)}"
          loading="lazy"
          alt="${esc(x.title)}">`
        :
        `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#eee;font-size:45px">
          🎬
         </div>`
       }

       <div class="play">▶</div>

      </div>

     </a>

     <div class="videoInfo">

      <a class="videoTitle"
         href="${esc(x.url)}"
         target="_blank"
         rel="noopener">

       ${esc(x.title)}

      </a>

      <div class="videoUrl">
       ${esc(x.url)}
      </div>

     </div>

    </article>

   `).join("")+

   '</div>';

 }catch{

  results.innerHTML=
   "<p>Video search is unavailable.</p>";

 }

}


/* NEWS */

async function loadNews(){

 try{

  const r=await fetch(
   "/api/news?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No news results found.</p>";

   return;

  }

  results.innerHTML=
   d.results.map(x=>`

    <article class="newsCard">

     ${
      x.image
      ?
      `<img
        class="newsThumb"
        src="${esc(x.image)}"
        loading="lazy"
        alt="">`
      :
      ""
     }

     <div class="newsBody">

      <a class="newsTitle"
         href="${esc(x.url)}"
         target="_blank"
         rel="noopener">

       ${esc(x.title)}

      </a>

      <div class="url">
       ${esc(x.url)}
      </div>

     </div>

    </article>

   `).join("");

 }catch{

  results.innerHTML=
   "<p>News search is unavailable.</p>";

 }

}


/* AI */

async function loadAI(){

 results.innerHTML=`

  <div class="aiBox">

   <div class="aiTitle">
    ✨ Goobrow AI
   </div>

   <div class="aiAnswer"
        id="aiAnswer">
    Thinking...
   </div>

  </div>

 `;

 try{

  const response=await fetch(
   "/api/ai",
   {
    method:"POST",
    headers:{
     "Content-Type":
      "application/json"
    },
    body:JSON.stringify({
     query
    })
   }
  );

  const data=await response.json();

  const answer=
   document.getElementById(
    "aiAnswer"
   );

  if(!response.ok){

   answer.textContent=
    data.error||
    "Goobrow AI is unavailable.";

   return;

  }

  answer.textContent=
   data.answer||
   "Goobrow AI returned no answer.";

 }catch{

  document.getElementById(
   "aiAnswer"
  ).textContent=
   "Goobrow AI could not connect to the AI service.";

 }

}


/* START */

if(!query){

 results.innerHTML=
  "<p>Please enter a search query.</p>";

}else if(mode==="images"){

 loadImages();

}else if(mode==="videos"){

 loadVideos();

}else if(mode==="news"){

 loadNews();

}
else if(mode==='academic'){
  results.innerHTML='<p>🎓 Loading academic results...</p>';

  fetch('/api/academic?q='+encodeURIComponent(query))
    .then(function(r){
      if(!r.ok) throw new Error('Academic API HTTP '+r.status);
      return r.json();
    })
    .then(function(d){
      let html='';

      html += '<div style="padding:12px 0;">';
      html += '<h2 style="margin:0 0 10px;">🎓 '+esc(d.subject||'Academics')+'</h2>';

      if(d.answer){
        html += '<div style="padding:14px;border-radius:12px;background:#f5f7fb;margin-bottom:16px;font-weight:500;">'+esc(d.answer)+'</div>';
      }

      if(d.results && d.results.length){
        d.results.forEach(function(x){
          html += '<article class="result">';
          html += '<a href="'+esc(x.url)+'" target="_blank" rel="noopener">';
          html += '<h3>'+esc(x.title)+'</h3>';
          html += '</a>';
          html += '<p>'+esc(x.description||'')+'</p>';
          html += '</article>';
        });
      }else if(d.type==='calculation'){
        html += '<p>Calculation completed successfully.</p>';
      }else{
        html += '<p>No additional academic results found.</p>';
      }

      html += '</div>';
      results.innerHTML=html;
    })
    .catch(function(error){
      console.error('Goobrow Academic:',error);
      results.innerHTML='<p>Academic search is temporarily unavailable. Please try again.</p>';
    });

}else if(mode==="ai"){

 loadAI();

}else{

 loadAll();

}

</script>


<style>
.goobrow-footer{text-align:center;border-top:1px solid #eee;padding:25px;margin-top:50px;font-size:14px}
.goobrow-footer a{color:#5f6368;text-decoration:none;margin:0 5px}
.goobrow-footer a:hover{text-decoration:underline}
</style>

