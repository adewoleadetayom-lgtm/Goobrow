<script>
/* ===== GOOGLE SEARCH HOMEPAGE ===== */

function goobrowGoogleSearch(event){
  if(event) event.preventDefault();

  const input=document.getElementById("searchInput");
  const q=input.value.trim();

  if(!q) return false;

  googleSuggestionHide();

  const googleUrl="https://www.google.com/search?q="+encodeURIComponent(q);

  if(typeof gbOpenBrowser==="function"){
    gbOpenBrowser(googleUrl);
  }else{
    window.location.href=googleUrl;
  }

  return false;
}

function googleLucky(){
  const input=document.getElementById("searchInput");
  const q=input.value.trim();

  if(!q) return;

  const url="https://www.google.com/search?btnI=1&q="+encodeURIComponent(q);

  if(typeof gbOpenBrowser==="function"){
    gbOpenBrowser(url);
  }else{
    window.location.href=url;
  }
}

function academicSearch(){
  const input=document.getElementById("searchInput");
  const q=input.value.trim();

  if(!q){
    input.focus();
    return;
  }

  googleSuggestionHide();

  const url="/results.html?q="+encodeURIComponent(q)+"&mode=academic";

  if(typeof gbOpenBrowser==="function"){
    gbOpenBrowser(url);
  }else{
    window.location.href=url;
  }
}

function googleVoiceSearch(){
  const input=document.getElementById("searchInput");

  const SpeechRecognition=
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if(!SpeechRecognition){
    alert("Voice search is not supported by this browser.");
    return;
  }

  const recognition=new SpeechRecognition();

  recognition.lang="en-NG";
  recognition.interimResults=false;
  recognition.maxAlternatives=1;

  recognition.onresult=function(event){
    const text=event.results[0][0].transcript;
    input.value=text;
    goobrowGoogleSearch();
  };

  recognition.onerror=function(){
    alert("Voice search could not be completed.");
  };

  recognition.start();
}

function googleSuggestionUpdate(){
  const input=document.getElementById("searchInput");
  const box=document.getElementById("googleSuggestions");
  const q=input.value.trim();

  if(!q){
    googleSuggestionHide();
    return;
  }

  const suggestions=[
    q+" news",
    q+" images",
    q+" videos",
    q+" wikipedia"
  ];

  box.innerHTML="";

  suggestions.forEach(function(item){
    const div=document.createElement("div");
    div.className="google-suggestion";
    div.textContent="⌕  "+item;

    div.onclick=function(){
      input.value=item;
      goobrowGoogleSearch();
    };

    box.appendChild(div);
  });

  box.style.display="block";
}

function googleSuggestionHide(){
  const box=document.getElementById("googleSuggestions");
  if(box) box.style.display="none";
}

function googleAppsMenu(){
  if(typeof gbOpenBrowser==="function"){
    gbOpenBrowser("https://www.google.com/");
  }
}

function googleSettings(){
  alert(
    "Goobrow Browser Settings\n\n"+
    "Use the browser menu for browser settings, "+
    "dark mode, history and bookmarks."
  );
}

document.addEventListener("click",function(event){
  const box=document.getElementById("googleSuggestions");
  const search=document.querySelector(".google-search-box");

  if(box && search && !search.contains(event.target)){
    googleSuggestionHide();
  }
});
</script>


