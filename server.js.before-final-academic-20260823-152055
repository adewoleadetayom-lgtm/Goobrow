

/* =====================================================
   GOOBROW MATH API
   ===================================================== */

app.get("/api/math",(req,res)=>{

  const query=String(req.query.q||"").trim();

  if(!query){

    return res.json({
      ok:false,
      message:"Please enter a mathematical question."
    });

  }

  const result=goobrowMathSolve(query);

  res.json(result);

});

app.listen(PORT, () => {
  console.log(`Goobrow search server running at http://localhost:${PORT}`);
});
