<script id="goobrow-download-manager-ui">

/* GOOBROW DOWNLOAD MANAGER UI */

const goobrowDownloads=[];

function goobrowDownloadManager(){

  const existing=document.getElementById("goobrow-download-panel");

  if(existing){
    existing.scrollIntoView({behavior:"smooth"});
    return;
  }

  const results=document.getElementById("results");

  if(!results) return;

  const panel=document.createElement("section");

  panel.id="goobrow-download-panel";

  panel.className="goobrow-download-panel";

  panel.innerHTML=
    '<h2>📥 Goobrow Downloads</h2>'+
    '<p>Downloads started from Goobrow will appear here.</p>'+
    '<div id="goobrow-download-list">'+
    '<p>No downloads yet.</p>'+
    '</div>';

  results.prepend(panel);

  goobrowRenderDownloads();
}


function goobrowRenderDownloads(){

  const list=document.getElementById("goobrow-download-list");

  if(!list) return;

  if(!goobrowDownloads.length){

    list.innerHTML='<p>No downloads yet.</p>';

    return;
  }

  list.innerHTML=goobrowDownloads.map(function(item){

    return (
      '<div class="goobrow-download-item">'+
        '<div class="goobrow-download-name">'+
        goobrowDownloadEsc(item.name)+
        '</div>'+

        '<div class="goobrow-download-status">'+
        goobrowDownloadEsc(item.status)+
        '</div>'+

        '<div class="goobrow-download-progress">'+
          '<div class="goobrow-download-progress-bar" style="width:'+
          Number(item.progress||0)+'%;"></div>'+
        '</div>'+

        '<div class="goobrow-download-actions">'+
          (item.status==="Completed" ?
            '<button onclick="goobrowOpenDownloadedFile(\''+
            goobrowDownloadEscAttr(item.url)+
            '\')">📂 Open</button>' : '')+

          '<button onclick="goobrowRemoveDownload(\''+
          goobrowDownloadEscAttr(item.id)+
          '\')">✕ Remove</button>'+
        '</div>'+
      '</div>'
    );

  }).join("");

}


function goobrowDownloadEsc(value){

  return String(value||"")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#39;");
}


function goobrowDownloadEscAttr(value){

  return String(value||"")
    .replace(/\\/g,"\\\\")
    .replace(/'/g,"\\'");
}


async function goobrowStartDownload(url,name){

  url=String(url||"").trim();

  if(!url){
    alert("No downloadable media URL was provided.");
    return;
  }

  let check;

  try{
    const response=await fetch(
      "/api/download-check?url="+encodeURIComponent(url)
    );
    check=await response.json();
  }catch(error){
    alert("Goobrow could not check this download.");
    return;
  }

  if(!check.downloadable){

    if(check.platform==="youtube"){
      alert(
        "This is a YouTube video. Goobrow does not bypass YouTube download restrictions. Please use YouTube's supported download options."
      );
    }else{
      alert(check.message||"This file cannot be downloaded by Goobrow.");
    }

    return;
  }

  const id=
    "download-"+Date.now()+"-"+Math.random().toString(36).slice(2);

  const item={
    id:id,
    name:name||"Goobrow download",
    url:url,
    status:"Starting...",
    progress:0,
    native:false,
    filePath:""
  };

  goobrowDownloads.unshift(item);
  goobrowDownloadManager();
  goobrowRenderDownloads();

  try{

    /*
     * Native Capacitor Android path.
     * The Capacitor bridge is available inside the Android app.
     */
    const CapacitorBridge=
      window.Capacitor &&
      window.Capacitor.Plugins &&
      window.Capacitor.Plugins.Filesystem;

    if(CapacitorBridge){

      item.native=true;
      item.status="Connecting...";
      goobrowRenderDownloads();

      const response=await fetch(url);

      if(!response.ok){
        throw new Error("HTTP "+response.status);
      }

      const total=Number(
        response.headers.get("content-length")||0
      );

      if(!response.body){
        throw new Error("Streaming unavailable.");
      }

      const reader=response.body.getReader();
      const chunks=[];
      let received=0;

      item.status="Downloading...";
      goobrowRenderDownloads();

      while(true){

        const part=await reader.read();

        if(part.done) break;

        chunks.push(part.value);
        received+=part.value.length;

        if(total){
          item.progress=Math.min(
            99,
            Math.round((received/total)*100)
          );

          item.status=
            "Downloading "+item.progress+"%";
        }else{
          item.status=
            "Downloading "+Math.round(received/1024)+" KB";
        }

        goobrowRenderDownloads();
      }

      const merged=new Uint8Array(received);
      let offset=0;

      for(const chunk of chunks){
        merged.set(chunk,offset);
        offset+=chunk.length;
      }

      let binary="";
      const sliceSize=0x8000;

      for(let i=0;i<merged.length;i+=sliceSize){
        binary+=String.fromCharCode(
          ...merged.subarray(
            i,
            Math.min(i+sliceSize,merged.length)
          )
        );
      }

      const base64=btoa(binary);

      const filename=
        goobrowSafeFilename(
          name||"goobrow-download"
        );

      const result=
        await CapacitorBridge.writeFile({
          path:"Goobrow Downloads/"+filename,
          data:base64,
          directory:"DOCUMENTS",
          recursive:true
        });

      item.filePath=
        result.uri||
        "Goobrow Downloads/"+filename;

      item.progress=100;
      item.status="Completed — saved on device";

      goobrowRenderDownloads();

      alert(
        "Download complete!\n\nSaved by Goobrow as:\n"+
        filename
      );

      return;
    }

    /*
     * Browser fallback.
     */
    const response=await fetch(url);

    if(!response.ok){
      throw new Error("HTTP "+response.status);
    }

    const total=Number(
      response.headers.get("content-length")||0
    );

    if(!response.body){
      throw new Error("Streaming is unavailable.");
    }

    const reader=response.body.getReader();
    const chunks=[];
    let received=0;

    item.status="Downloading...";
    goobrowRenderDownloads();

    while(true){

      const part=await reader.read();

      if(part.done) break;

      chunks.push(part.value);
      received+=part.value.length;

      if(total){
        item.progress=Math.min(
          100,
          Math.round((received/total)*100)
        );

        item.status=
          "Downloading "+item.progress+"%";
      }else{
        item.status=
          "Downloading "+Math.round(received/1024)+" KB";
      }

      goobrowRenderDownloads();
    }

    const blob=new Blob(chunks);
    const objectURL=URL.createObjectURL(blob);
    const link=document.createElement("a");

    link.href=objectURL;
    link.download=
      goobrowSafeFilename(
        name||"goobrow-download"
      );

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(function(){
      URL.revokeObjectURL(objectURL);
    },30000);

    item.progress=100;
    item.status="Completed";

    item.url=objectURL;

    goobrowRenderDownloads();

  }catch(error){

    console.error(
      "Goobrow native download error:",
      error
    );

    item.status=
      "Download failed: "+
      (error.message||"source blocked direct download");

    item.progress=0;

    goobrowRenderDownloads();
  }
}

function goobrowSafeFilename(name){

  return String(name||"download")
    .replace(/[\\\\/:*?"<>|]/g,"_")
    .slice(0,120);
}


function goobrowRemoveDownload(id){

  const index=
    goobrowDownloads.findIndex(
      function(item){
        return item.id===id;
      }
    );

  if(index!==-1){

    const item=goobrowDownloads[index];

    if(item.url && item.url.startsWith("blob:")){

      try{
        URL.revokeObjectURL(item.url);
      }catch(e){}

    }

    goobrowDownloads.splice(index,1);

  }

  goobrowRenderDownloads();

}


function goobrowOpenDownloadedFile(url){

  if(!url) return;

  window.open(url,"_blank");

}


/* END GOOBROW DOWNLOAD MANAGER UI */

</script>

