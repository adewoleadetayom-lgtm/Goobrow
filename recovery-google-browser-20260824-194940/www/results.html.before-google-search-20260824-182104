<body>

<header class="header">

<div class="headrow">
<a class="menu" href="index.html">☰</a>

<a class="logo" href="index.html">
<span>G</span><span>o</span><span>o</span><span>b</span>
<span>r</span><span>o</span><span>w</span>
</a>
</div>

<form class="search" id="searchForm">
<input id="searchInput"
 autocomplete="off"
 placeholder="Search with Goobrow">

<button type="submit">🔎</button>
</form>

</header>

<nav class="tabs">

<a class="tab" data-mode="all">All</a>
<a class="tab" data-mode="images">Images</a>
<a class="tab" data-mode="videos">Videos</a>
<a class="tab" data-mode="news">News</a>
<a class="tab" data-mode="ai">AI Mode</a>
<a class="tab" data-mode="academic">Academics</a>

</nav>

<main class="content">
<div id="results"></div>

<div id="goobrow-google-cse" style="margin:20px 0;">
  </div>
</main>

<script>

const params=new URLSearchParams(location.search);

const query=params.get("q")||"";
const mode=params.get("mode")||"all";

const input=document.getElementById("searchInput");
const results=document.getElementById("results");

input.value=query;

document.querySelectorAll(".tab").forEach(tab=>{

 tab.classList.toggle(
  "active",
  tab.dataset.mode===mode
 );

 tab.onclick=()=>{

  if(!query)return;

  location.href=
   "results.html?q="+
   encodeURIComponent(query)+
   "&mode="+
   tab.dataset.mode;

 };

});

document
.getElementById("searchForm")
.addEventListener("submit",e=>{

 e.preventDefault();

 const q=input.value.trim();

 if(q){

  location.href=
   "results.html?q="+
   encodeURIComponent(q)+
   "&mode=all";

 }

});

function esc(x){

 const d=document.createElement("div");

 d.textContent=x??"";

 return d.innerHTML;

}


/* ALL */

async function loadAll(){

 try{

  const r=await fetch(
   "/api/search?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No results found.</p>";

   return;

  }

  results.innerHTML=d.results.map(x=>`

   <div class="result">

    <a class="title"
       href="${esc(x.url)}"
       target="_blank"
       rel="noopener">

       ${esc(x.title)}

    </a>

    <div class="url">
     ${esc(x.url)}
    </div>

    <div class="desc">
     ${esc(x.description)}
    </div>

   </div>

  `).join("");

 }catch{

  results.innerHTML=
   "<p>Goobrow could not load results.</p>";

 }

}


/* IMAGES */

async function loadImages(){

 try{

  const r=await fetch(
   "/api/images?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No images found.</p>";

   return;

  }

  results.innerHTML=
   '<div class="imageGrid">'+

   d.results.map(x=>`

    <div class="imageCard">

     <a href="${esc(x.image)}"
        target="_blank"
        rel="noopener">

      <img
       src="${esc(x.image)}"
       loading="lazy"
       alt="${esc(x.title)}">

     </a>

     <div class="imageTitle">
      ${esc(x.title)}
     </div>

    </div>

   `).join("")+

   '</div>';

 }catch{

  results.innerHTML=
   "<p>Goobrow image search is unavailable.</p>";

 }

}


/* VIDEOS */

async function loadVideos(){

 try{

  const r=await fetch(
   "/api/videos?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No video results found.</p>";

   return;

  }

  results.innerHTML=
   '<div class="videoGrid">'+

   d.results.map(x=>`

    <article class="videoCard">

     <a href="${esc(x.url)}"
        target="_blank"
        rel="noopener">

      <div class="videoThumb">

       ${
        x.image
        ?
        `<img
          src="${esc(x.image)}"
          loading="lazy"
          alt="${esc(x.title)}">`
        :
        `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#eee;font-size:45px">
          🎬
         </div>`
       }

       <div class="play">▶</div>

      </div>

     </a>

     <div class="videoInfo">

      <a class="videoTitle"
         href="${esc(x.url)}"
         target="_blank"
         rel="noopener">

       ${esc(x.title)}

      </a>

      <div class="videoUrl">
       ${esc(x.url)}
      </div>

     </div>

    </article>

   `).join("")+

   '</div>';

 }catch{

  results.innerHTML=
   "<p>Video search is unavailable.</p>";

 }

}


/* NEWS */

async function loadNews(){

 try{

  const r=await fetch(
   "/api/news?q="+
   encodeURIComponent(query)
  );

  const d=await r.json();

  if(!d.results?.length){

   results.innerHTML=
    "<p>No news results found.</p>";

   return;

  }

  results.innerHTML=
   d.results.map(x=>`

    <article class="newsCard">

     ${
      x.image
      ?
      `<img
        class="newsThumb"
        src="${esc(x.image)}"
        loading="lazy"
        alt="">`
      :
      ""
     }

     <div class="newsBody">

      <a class="newsTitle"
         href="${esc(x.url)}"
         target="_blank"
         rel="noopener">

       ${esc(x.title)}

      </a>

      <div class="url">
       ${esc(x.url)}
      </div>

     </div>

    </article>

   `).join("");

 }catch{

  results.innerHTML=
   "<p>News search is unavailable.</p>";

 }

}


/* AI */

async function loadAI(){

 results.innerHTML=`

  <div class="aiBox">

   <div class="aiTitle">
    ✨ Goobrow AI
   </div>

   <div class="aiAnswer"
        id="aiAnswer">
    Thinking...
   </div>

  </div>

 `;

 try{

  const response=await fetch(
   "/api/ai",
   {
    method:"POST",
    headers:{
     "Content-Type":
      "application/json"
    },
    body:JSON.stringify({
     query
    })
   }
  );

  const data=await response.json();

  const answer=
   document.getElementById(
    "aiAnswer"
   );

  if(!response.ok){

   answer.textContent=
    data.error||
    "Goobrow AI is unavailable.";

   return;

  }

  answer.textContent=
   data.answer||
   "Goobrow AI returned no answer.";

 }catch{

  document.getElementById(
   "aiAnswer"
  ).textContent=
   "Goobrow AI could not connect to the AI service.";

 }

}


/* START */

if(!query){

 results.innerHTML=
  "<p>Please enter a search query.</p>";

}else if(mode==="images"){

 loadImages();

}else if(mode==="videos"){

 loadVideos();

}else if(mode==="news"){

 loadNews();

}
else if(mode==="academic"){
  goobrowAcademicSuperSearch(query);
  return;
}
/* ORIGINAL ACADEMIC MODE DISABLED */
if(false){
  results.innerHTML='<p>🎓 Loading academic results...</p>';

  fetch('/api/academic?q='+encodeURIComponent(q))
    .then(r=>r.json())
    .then(d=>{
      let html='';

      html += '<div style="padding:12px 0;">';
      html += '<h2 style="margin:0 0 10px;">🎓 '+(d.subject||'Academics')+'</h2>';

      if(d.answer){
        html += '<div style="padding:14px;border-radius:12px;background:#f5f7fb;margin-bottom:16px;font-weight:500;">'+d.answer+'</div>';
      }

      if(d.results && d.results.length){
        d.results.forEach(function(x){
          html += '<article class="result">';
          html += '<a href="'+x.url+'" target="_blank" rel="noopener">';
          html += '<h3>'+x.title+'</h3>';
          html += '</a>';
          html += '<p>'+(x.description||'')+'</p>';
          html += '</article>';
        });
      }

      html += '</div>';
      results.innerHTML=html;
    })
    .catch(function(){
      results.innerHTML='<p>Academic search is temporarily unavailable.</p>';
    });

}else if(mode==="ai"){

 loadAI();

}else{

 loadAll();

}

</script>


