<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Goobrow Search</title>

<style>
*{box-sizing:border-box}

body{
 margin:0;
 font-family:Arial,Helvetica,sans-serif;
 color:#202124;
 background:#fff
}

.header{
 border-bottom:1px solid #eee;
 padding:14px 22px
}

.headrow{
 display:flex;
 align-items:center;
 gap:22px
}

.menu{
 font-size:25px;
 text-decoration:none;
 color:#333
}

.logo{
 font-size:30px;
 font-weight:700;
 letter-spacing:-2px;
 text-decoration:none
}

.logo span:nth-child(1){color:#4285f4}
.logo span:nth-child(2){color:#ea4335}
.logo span:nth-child(3){color:#fbbc05}
.logo span:nth-child(4){color:#4285f4}
.logo span:nth-child(5){color:#34a853}
.logo span:nth-child(6){color:#ea4335}
.logo span:nth-child(7){color:#4285f4}

.search{
 margin-top:14px;
 width:min(700px,100%);
 height:48px;
 border:1px solid #dfe1e5;
 border-radius:25px;
 display:flex;
 align-items:center;
 padding:0 15px;
 background:#fff
}

.search:focus-within{
 box-shadow:0 1px 6px #20212430
}

.search input{
 flex:1;
 border:0;
 outline:0;
 font-size:16px;
 min-width:0
}

.search button{
 border:0;
 background:none;
 font-size:20px;
 cursor:pointer
}

.tabs{
 width:min(1000px,94%);
 margin:auto;
 border-bottom:1px solid #eee;
 display:flex;
 gap:4px;
 overflow-x:auto
}

.tab{
 padding:15px 18px;
 text-decoration:none;
 color:#5f6368;
 white-space:nowrap;
 cursor:pointer
}

.tab.active{
 color:#1a73e8;
 border-bottom:3px solid #1a73e8
}

.content{
 width:min(900px,94%);
 margin:25px auto 60px
}

.result{
 margin-bottom:28px
}

.result a.title{
 font-size:20px;
 color:#1a0dab;
 text-decoration:none
}

.result a.title:hover{
 text-decoration:underline
}

.url{
 font-size:13px;
 color:#188038;
 margin:5px 0
}

.desc{
 font-size:14px;
 line-height:1.5;
 color:#4d5156
}

/* IMAGES */

.imageGrid{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:14px
}

.imageCard{
 border:1px solid #eee;
 border-radius:12px;
 overflow:hidden;
 background:#fff;
 transition:.15s
}

.imageCard:hover{
 box-shadow:0 2px 10px #0002;
 transform:translateY(-1px)
}

.imageCard img{
 width:100%;
 height:170px;
 object-fit:cover;
 display:block;
 background:#f5f5f5
}

.imageTitle{
 padding:9px;
 font-size:13px;
 line-height:1.35
}

/* VIDEOS */

.videoGrid{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:20px
}

.videoCard{
 border:1px solid #e5e5e5;
 border-radius:12px;
 overflow:hidden;
 background:#fff;
 transition:.15s
}

.videoCard:hover{
 box-shadow:0 2px 10px #0002
}

.videoThumb{
 position:relative;
 width:100%;
 aspect-ratio:16/9;
 background:#eee;
 overflow:hidden
}

.videoThumb img{
 width:100%;
 height:100%;
 object-fit:cover;
 display:block
}

.play{
 position:absolute;
 left:50%;
 top:50%;
 transform:translate(-50%,-50%);
 width:58px;
 height:58px;
 border-radius:50%;
 background:#000b;
 color:white;
 display:flex;
 align-items:center;
 justify-content:center;
 font-size:25px;
 padding-left:4px
}

.videoInfo{
 padding:13px
}

.videoTitle{
 color:#202124;
 font-size:16px;
 font-weight:600;
 line-height:1.35;
 text-decoration:none;
 display:block
}

.videoTitle:hover{
 color:#1a73e8
}

.videoUrl{
 font-size:12px;
 color:#188038;
 margin-top:7px;
 white-space:nowrap;
 overflow:hidden;
 text-overflow:ellipsis
}

/* NEWS */

.newsCard{
 display:flex;
 gap:15px;
 border-bottom:1px solid #eee;
 padding:15px 0
}

.newsThumb{
 width:150px;
 height:90px;
 flex:none;
 object-fit:cover;
 border-radius:8px;
 background:#eee
}

.newsBody{
 flex:1
}

.newsTitle{
 font-size:18px;
 color:#1a0dab;
 text-decoration:none;
 line-height:1.3
}

.newsTitle:hover{
 text-decoration:underline
}

/* AI */

.aiBox{
 border:1px solid #dadce0;
 border-radius:16px;
 padding:20px;
 margin-bottom:25px;
 background:#fff;
 box-shadow:0 1px 4px #0001
}

.aiTitle{
 font-size:20px;
 font-weight:600;
 margin-bottom:12px
}

.aiAnswer{
 font-size:15px;
 line-height:1.7;
 white-space:pre-wrap
}

@media(max-width:700px){

 .header{
  padding:12px 15px
 }

 .logo{
  font-size:25px
 }

 .content{
  width:94%;
  margin-top:18px
 }

 .imageGrid{
  grid-template-columns:repeat(2,1fr);
  gap:10px
 }

 .imageCard img{
  height:140px
 }

 .videoGrid{
  grid-template-columns:1fr;
  gap:15px
 }

 .videoTitle{
  font-size:15px
 }

 .newsThumb{
  width:110px;
  height:75px
 }

 .newsTitle{
  font-size:16px
 }
}
</style>

