<script id="goobrow-news-media-renderer">
(function(){

  function escapeHTML(value){
    return String(value || "")
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;")
      .replace(/'/g,"&#039;");
  }

  function newsMedia(item){

    const image =
      item.image ||
      item.thumbnail ||
      item.imageUrl ||
      "";

    const video =
      item.video ||
      item.videoUrl ||
      item.video_url ||
      "";

    if(video){
      return `
        <video
          src="${escapeHTML(video)}"
          controls
          muted
          playsinline
          preload="metadata">
        </video>
      `;
    }

    if(image){
      return `
        <img
          src="${escapeHTML(image)}"
          loading="lazy"
          onerror="this.parentElement.innerHTML='<span style=&quot;display:flex;height:100%;align-items:center;justify-content:center;font-size:32px&quot;>📰</span>'"
          alt="">
      `;
    }

    return `
      <span style="
        display:flex;
        height:100%;
        align-items:center;
        justify-content:center;
        font-size:36px;">
        📰
      </span>
    `;
  }

  window.goobrowRenderNews = function(results, container){

    if(!container) return;

    if(!Array.isArray(results) || !results.length){
      container.innerHTML =
        '<p>No news results found.</p>';
      return;
    }

    container.innerHTML = results.map(item => {

      const title =
        item.title ||
        "Untitled news";

      const url =
        item.url ||
        item.link ||
        "#";

      const description =
        item.description ||
        item.snippet ||
        "";

      const source =
        item.source ||
        item.publisher ||
        "News";

      const date =
        item.publishedAt ||
        item.date ||
        "";

      return `
        <article class="goobrow-news-card">

          <div class="goobrow-news-media">
            ${newsMedia(item)}
          </div>

          <div class="goobrow-news-content">

            <div class="goobrow-news-title">
              <a
                href="${escapeHTML(url)}"
                target="_blank"
                rel="noopener noreferrer">
                ${escapeHTML(title)}
              </a>
            </div>

            <div class="goobrow-news-source">
              ${escapeHTML(source)}
            </div>

            <div class="goobrow-news-description">
              ${escapeHTML(
                String(description)
                  .replace(/<[^>]*>/g," ")
              )}
            </div>

            ${
              date
              ? `<div class="goobrow-news-date">
                   ${escapeHTML(date)}
                 </div>`
              : ""
            }

          </div>

        </article>
      `;

    }).join("");
  };

})();
</script>


