<script id="goobrow-native-download-status-script">
/* GOOBROW NATIVE DOWNLOAD STATUS */

(function(){

  function detectNativeDownloads(){

    const native=
      !!(
        window.Capacitor &&
        window.Capacitor.Plugins &&
        window.Capacitor.Plugins.Filesystem
      );

    window.goobrowNativeDownloadsAvailable=native;

    console.log(
      "Goobrow native downloads:",
      native ? "AVAILABLE" : "BROWSER FALLBACK"
    );
  }

  if(document.readyState==="loading"){
    document.addEventListener(
      "DOMContentLoaded",
      detectNativeDownloads
    );
  }else{
    detectNativeDownloads();
  }

})();

/* END GOOBROW NATIVE DOWNLOAD STATUS */
</script>

