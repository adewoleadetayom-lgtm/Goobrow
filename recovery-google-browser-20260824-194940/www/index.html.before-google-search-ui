<script>

function goobrowCurrentUser(){
  try{
    return JSON.parse(
      localStorage.getItem("goobrowUser") || "null"
    );
  }catch{
    return null;
  }
}

async function goobrowCreatePost(){

  const user=goobrowCurrentUser();
  const text=document
    .getElementById("goobrow-post-text")
    .value.trim();

  const message=document
    .getElementById("goobrow-post-message");

  if(!user){
    message.textContent="Please sign in first.";
    return;
  }

  if(!text){
    message.textContent="Write something first.";
    return;
  }

  message.textContent="Saving post...";

  try{

    const response=await fetch("/api/posts",{
      method:"POST",
      headers:{
        "Content-Type":"application/json"
      },
      body:JSON.stringify({
        userId:user.id,
        text:text
      })
    });

    const data=await response.json();

    if(!data.ok){
      message.textContent=data.error || "Could not save post.";
      return;
    }

    document.getElementById("goobrow-post-text").value="";
    message.textContent="Post saved successfully.";

    goobrowLoadPosts();

  }catch(error){
    message.textContent="Unable to connect to Goobrow.";
  }
}

async function goobrowLoadPosts(){

  const box=document.getElementById("goobrow-home-posts");

  try{

    const response=await fetch("/api/posts");
    const data=await response.json();

    const posts=data.posts || [];

    if(!posts.length){
      box.innerHTML="<p>No community posts yet. Be the first to post!</p>";
      return;
    }

    box.innerHTML=posts.map(post=>{

      const date=new Date(post.createdAt)
        .toLocaleString();

      return `
        <article class="goobrow-post">
          <div class="goobrow-post-name">
            👤 ${String(post.userName)
              .replace(/</g,"&lt;")
              .replace(/>/g,"&gt;")}
          </div>

          <div class="goobrow-post-date">
            ${date}
          </div>

          <div class="goobrow-post-text">
            ${String(post.text)
              .replace(/</g,"&lt;")
              .replace(/>/g,"&gt;")}
          </div>

          <button class="goobrow-like"
            onclick="goobrowLikePost('${post.id}')">
            👍 ${post.likes || 0}
          </button>
        </article>
      `;

    }).join("");

  }catch(error){

    box.innerHTML=
      "<p>Community posts are temporarily unavailable.</p>";

  }
}

async function goobrowLikePost(id){

  try{

    const response=await fetch(
      "/api/posts/"+encodeURIComponent(id)+"/like",
      {method:"POST"}
    );

    const data=await response.json();

    if(data.ok){
      goobrowLoadPosts();
    }

  }catch{}
}

async function goobrowLoadHomeVideos(){

  const box=document.getElementById(
    "goobrow-home-videos"
  );

  try{

    const response=await fetch(
      "/api/videos?q=latest"
    );

    const data=await response.json();

    const videos=data.results || data.videos || [];

    if(!videos.length){
      box.innerHTML="<p>Latest videos are temporarily unavailable.</p>";
      return;
    }

    box.innerHTML=
      '<div class="goobrow-video-grid">'+
      videos.slice(0,6).map(video=>{

        const title=video.title || "Video";
        const url=video.url || video.link || "#";

        return `
          <div class="goobrow-video-item">
            🎥
            <a href="${url}"
              target="_blank"
              rel="noopener">
              ${String(title)
                .replace(/</g,"&lt;")
                .replace(/>/g,"&gt;")}
            </a>
          </div>
        `;

      }).join("")+
      "</div>";

  }catch{

    box.innerHTML=
      "<p>Latest videos are temporarily unavailable.</p>";

  }
}

async function goobrowLoadHomeNews(){

  const box=document.getElementById(
    "goobrow-home-news"
  );

  try{

    const response=await fetch(
      "/api/news?q=latest"
    );

    const data=await response.json();

    const items=data.results || data.news || [];

    if(!items.length){
      box.innerHTML=
        "<p>Latest news is temporarily unavailable.</p>";
      return;
    }

    box.innerHTML=items.slice(0,6).map(item=>{

      const title=item.title || "Latest news";
      const url=item.url || item.link || "#";
      const description=
        item.description || item.snippet || "";

      return `
        <div class="goobrow-post">
          <a href="${url}"
            target="_blank"
            rel="noopener"
            style="font-weight:600;color:#1a73e8;text-decoration:none">
            ${String(title)
              .replace(/</g,"&lt;")
              .replace(/>/g,"&gt;")}
          </a>

          <p style="color:#5f6368">
            ${String(description)
              .replace(/</g,"&lt;")
              .replace(/>/g,"&gt;")}
          </p>
        </div>
      `;

    }).join("");

  }catch{

    box.innerHTML=
      "<p>Latest news is temporarily unavailable.</p>";

  }
}

document.addEventListener(
  "DOMContentLoaded",
  ()=>{
    goobrowLoadPosts();
    goobrowLoadHomeNews();
    goobrowLoadHomeVideos();
  }
);

</script>

</body>
