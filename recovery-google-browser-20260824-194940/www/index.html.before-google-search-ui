<div id="goobrow-account-panel" class="goobrow-account-panel">
  <button class="goobrow-account-button" onclick="goobrowToggleAccount()">👤 Account</button>
  <div id="goobrow-account-menu" class="goobrow-account-menu">
    <div id="goobrow-auth-area">
      <h3 style="margin:0 0 8px">Goobrow Account</h3>
      <input id="goobrow-name" placeholder="Your name">
      <input id="goobrow-email" type="email" placeholder="Email">
      <input id="goobrow-password" type="password" placeholder="Password">
      <button class="goobrow-primary" onclick="goobrowRegister()">Create account</button>
      <button class="goobrow-secondary" onclick="goobrowLogin()">Sign in</button>
      <p id="goobrow-auth-message" style="font-size:13px"></p>
    </div>
    <div id="goobrow-profile-area" class="goobrow-profile">
      <strong id="goobrow-profile-name"></strong>
      <div id="goobrow-profile-email"></div>
      <div id="goobrow-profile-joined" style="font-size:12px;color:#777;margin-top:5px"></div>
      <button class="goobrow-secondary" onclick="goobrowLogout()">Sign out</button>
    </div>
  </div>
</div>

<div id="goobrow-news-box" class="goobrow-news-box">
  <h2>📰 Latest News</h2>
  <div id="goobrow-home-news">Loading latest news...</div>
</div>

<script>
function goobrowToggleAccount(){
  document.getElementById("goobrow-account-menu").classList.toggle("open");
}

function goobrowMessage(text){
  document.getElementById("goobrow-auth-message").textContent=text;
}

function goobrowShowProfile(user){
  document.getElementById("goobrow-auth-area").style.display="none";
  const p=document.getElementById("goobrow-profile-area");
  p.classList.add("show");
  document.getElementById("goobrow-profile-name").textContent="👋 "+user.name;
  document.getElementById("goobrow-profile-email").textContent=user.email;
  document.getElementById("goobrow-profile-joined").textContent=
    "Member since "+new Date(user.joined).toLocaleDateString();
}

function goobrowShowLogin(){
  document.getElementById("goobrow-auth-area").style.display="block";
  document.getElementById("goobrow-profile-area").classList.remove("show");
}

async function goobrowRegister(){
  const name=document.getElementById("goobrow-name").value.trim();
  const email=document.getElementById("goobrow-email").value.trim();
  const password=document.getElementById("goobrow-password").value;

  goobrowMessage("Creating account...");

  try{
    const r=await fetch("/api/register",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({name,email,password})
    });
    const data=await r.json();

    if(!data.ok){
      goobrowMessage(data.error || "Registration failed.");
      return;
    }

    localStorage.setItem("goobrowUser",JSON.stringify(data.user));
    goobrowShowProfile(data.user);
  }catch(e){
    goobrowMessage("Unable to connect to Goobrow.");
  }
}

async function goobrowLogin(){
  const email=document.getElementById("goobrow-email").value.trim();
  const password=document.getElementById("goobrow-password").value;

  goobrowMessage("Signing in...");

  try{
    const r=await fetch("/api/login",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({email,password})
    });
    const data=await r.json();

    if(!data.ok){
      goobrowMessage(data.error || "Login failed.");
      return;
    }

    localStorage.setItem("goobrowUser",JSON.stringify(data.user));
    goobrowShowProfile(data.user);
  }catch(e){
    goobrowMessage("Unable to connect to Goobrow.");
  }
}

function goobrowLogout(){
  localStorage.removeItem("goobrowUser");
  goobrowShowLogin();
  goobrowMessage("Signed out.");
}

function goobrowRestoreAccount(){
  try{
    const user=JSON.parse(localStorage.getItem("goobrowUser")||"null");
    if(user) goobrowShowProfile(user);
  }catch{}
}

async function goobrowLoadLatestNews(){
  const box=document.getElementById("goobrow-home-news");
  try{
    const r=await fetch("/api/news?q=latest");
    const data=await r.json();
    const items=data.results || data.news || [];

    if(!items.length){
      box.innerHTML="<p>Latest news is temporarily unavailable.</p>";
      return;
    }

    box.innerHTML=items.slice(0,6).map(item=>{
      const title=item.title || "Latest news";
      const url=item.url || item.link || "#";
      const desc=item.description || item.snippet || "";
      return '<div class="goobrow-news-item">'+
        '<a href="'+url+'" target="_blank" rel="noopener">'+
        title.replace(/</g,"&lt;").replace(/>/g,"&gt;")+
        '</a><p>'+desc.replace(/</g,"&lt;").replace(/>/g,"&gt;")+'</p></div>';
    }).join("");
  }catch(e){
    box.innerHTML="<p>Latest news is temporarily unavailable.</p>";
  }
}

document.addEventListener("DOMContentLoaded",()=>{
  goobrowRestoreAccount();
  goobrowLoadLatestNews();
});
</script>


